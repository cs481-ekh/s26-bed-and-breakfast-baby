# ============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in the appropriate values for your environment.
# NEVER commit the actual .env file to version control!
# NOTE: Variables must start with VITE_ to be exposed to the browser in Vite
#
# Development Example (leave blank or empty):
#   VITE_PUBLIC_URL=
#   VITE_API_ROOT=
#
# SDP Production Example:
#   VITE_PUBLIC_URL=/s26-bed-and-breakfast-baby
#   VITE_API_ROOT=https://sdp.boisestate.edu/s26-bed-and-breakfast-baby/api

# ============================================================================
# PUBLIC URL / BASE PATH
# ============================================================================
# The base path for all frontend routes when deployed on a subdirectory
# Leave empty for local development (or on root domain)
# For SDP deployment, set to: /s26-bed-and-breakfast-baby
# This configures React Router's basename to handle nested routing
VITE_PUBLIC_URL=

# ============================================================================
# BACKEND API ROOT URL
# ============================================================================
# The base URL for all API calls to the backend
# Leave empty for local development (defaults to relative paths)
# For SDP deployment, set to the full API path
# Example: https://sdp.boisestate.edu/s26-bed-and-breakfast-baby/api
VITE_API_ROOT=

# ============================================================================
# BUILD SETTINGS
# ============================================================================
# Optional: Set to production for optimized builds
# NODE_ENV defaults to development
