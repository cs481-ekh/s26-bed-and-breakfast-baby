# This template was generated by AI, using this to help setup our .env file - Alex 
# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in the appropriate values for your environment.
# NEVER commit the actual .env file to version control!
#
# Development Example:
#   SECRET_KEY=django-insecure-dev-key-change-in-production
#   DEBUG=True
#   ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
#
# Production Example:
#   SECRET_KEY=<generate-random-secret-key>
#   DEBUG=False
#   ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================================================
# APPLICATION ROOT PATH (For SDP Deployment)
# ============================================================================

# Application root path for URL prefix on SDP server
# Leave empty for local development: APP_ROOT=
# For SDP deployment, set to project name: APP_ROOT=s26-bed-and-breakfast-baby
# This will prepend the path to all URLs: /s26-bed-and-breakfast-baby/api/, etc.
APP_ROOT=

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# REQUIRED: Django secret key for session and CSRF protection.
# Generate a new secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# CRITICAL: Keep this secret and unique per environment!
SECRET_KEY=your-super-secret-key-here

# Debug mode - set to False in production to prevent information disclosure
# Valid values: True, False
DEBUG=True

# Allowed hosts - comma-separated list of domains/IPs this Django server will serve
# Example: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database name
DB_NAME=bed_and_breakfast_db

# PostgreSQL database user
DB_USER=postgres

# PostgreSQL database password
# SECURITY: Use a strong password in production!
DB_PASSWORD=strong-secure-password-here

# PostgreSQL database host
DB_HOST=postgres

# PostgreSQL database port
DB_PORT=5432

# ============================================================================
# HTTPS AND SECURITY HEADERS
# ============================================================================

# Enforce HTTPS in production (set to True in production)
SECURE_SSL_REDIRECT=False

# Optional: Specify a host to redirect HTTP to HTTPS
# SECURE_SSL_HOST=yourdomain.com

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend URL for building invitation links
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ============================================================================
# CORS AND CSRF CONFIGURATION
# ============================================================================

# CORS allowed origins - comma-separated list of domains that can make requests
# Development: http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# CSRF trusted origins - same as CORS for this application
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level for general application logs
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log level for security-related logs (authentication, authorization, etc.)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
SECURITY_LOG_LEVEL=INFO
